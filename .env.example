# weather-x402 — Seller (resource server) configuration. Copy to .env.
# Only the values marked REQUIRED must be set; everything else has a default.

# ── This service (all optional — defaults shown) ─────────────────────────────
# PORT=8408
# HOST=127.0.0.1
# PUBLIC_BASE_URL=http://127.0.0.1:8408
# CORS_ORIGIN=*
# MAX_BODY_SIZE=256kb
# SHUTDOWN_TIMEOUT_MS=10000

# ── Payment gating ───────────────────────────────────────────────────────────
X402_ENABLED=true                        # false = no payment, paid routes answer directly
X402_SCHEME=both                         # exact | upto | both
X402_PAY_TO=G_YOUR_TESTNET_RECEIVER      # REQUIRED — receives USDC; must hold a USDC trustline
# X402_NETWORK=stellar:testnet           # default
# X402_USDC_AMOUNT_ATOMIC=40000          # default — 0.004 USDC (7 decimals)

# ── Facilitator (the x402 verify/settle service this connects to) ────────────
X402_FACILITATOR_URL=https://agentsmith.xyz/facilitator   # AgentSmith Facilitator API base URL
# X402_FACILITATOR_TIMEOUT_MS=45000          # default
# The upto settlement contract and facilitator signer are read from the Facilitator's
# /supported at startup — you do not configure them here. Uncomment to override:
# X402_UPTO_KERNEL_CONTRACT=
# X402_FACILITATOR_ADDRESS=

# ── Optional ─────────────────────────────────────────────────────────────────
# BAZAAR_URL=http://localhost:8402       # used only by `npm run register` (discovery listing)
